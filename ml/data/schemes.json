      "residence": "profile.residence must match",
      "land_holding_max_ha": "profile.land_holding_ha must be <= this",
      "annual_income_max": "profile.annual_household_income must be <= this",
      "monthly_income_max": "profile.monthly_income must be <= this",
      "requires": "every named boolean profile flag must be true",
      "excluded_if": "any named boolean profile flag being true disqualifies"
    }
